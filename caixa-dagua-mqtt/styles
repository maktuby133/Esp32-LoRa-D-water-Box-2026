<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss://*.hivemq.cloud:8884;">
  <title>🌊 Monitor Inteligente de Caixa d'Água - MQTT</title>
  
  <!-- MQTT.js Library para WebSocket -->
  <script src="https://unpkg.com/mqtt@5.3.0/dist/mqtt.min.js"></script>
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="container">
    <!-- HEADER -->
    <div class="header">
      <h1>
        <i class="fas fa-water"></i>
        Monitor Inteligente de Caixa d'Água
      </h1>
      <p class="subtitle">Sistema de Monitoramento via LoRa + MQTT HiveMQ</p>
      
      <!-- MQTT STATUS -->
      <div class="mqtt-status" id="mqttStatus">
        <i class="fas fa-circle-notch fa-spin"></i>
        <span>Conectando ao MQTT...</span>
      </div>
    </div>

    <!-- PAINEL DE CONFIGURAÇÃO MQTT -->
    <div class="config-panel">
      <h3><i class="fas fa-cog"></i> Configuração MQTT HiveMQ</h3>
      <div class="config-form">
        <div class="form-group">
          <label>Broker WebSocket:</label>
          <input type="text" id="mqttBroker" value="wss://4e7f2439378945bfbd24b2a1777b5ea2.s1.eu.hivemq.cloud:8884/mqtt" placeholder="wss://broker.hivemq.cloud:8884/mqtt">
        </div>
        <div class="form-group">
          <label>Cliente ID / Usuário:</label>
          <input type="text" id="mqttUser" value="hivemq.webclient.1769967284481" placeholder="Usuário MQTT">
        </div>
        <div class="form-group">
          <label>Senha:</label>
          <input type="password" id="mqttPassword" value="P;:MJ<.3A012EGqbrcda" placeholder="Senha MQTT">
        </div>
        <div class="form-group">
          <label>&nbsp;</label>
          <button class="btn btn-primary" id="connectBtn">
            <i class="fas fa-sync"></i> Conectar
          </button>
        </div>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div class="dashboard">
      <!-- CARD: NÍVEL DA CAIXA -->
      <div class="card">
        <div class="card-title">
          <i class="fas fa-tint"></i>
          Nível da Caixa
        </div>
        <div class="card-value" id="percentage">--</div>
        
        <!-- VISUALIZAÇÃO DO TANQUE -->
        <div class="tank-container">
          <div class="water-level" id="waterLevel" style="height: 0%;">
            <div class="water-waves"></div>
            <span id="waterPercentage">0%</span>
          </div>
        </div>
      </div>

      <!-- CARD: VOLUME ATUAL -->
      <div class="card">
        <div class="card-title">
          <i class="fas fa-droplet"></i>
          Volume Atual
        </div>
        <div class="card-value" id="liters">-- L</div>
        <p style="color: var(--gray); margin-top: 10px;">
          <strong id="litersActual">0</strong> de <strong id="litersTotal">0</strong> litros
        </p>
      </div>

      <!-- CARD: DISTÂNCIA -->
      <div class="card">
        <div class="card-title">
          <i class="fas fa-ruler-vertical"></i>
          Distância Sensor
        </div>
        <div class="card-value" id="distance">-- cm</div>
        <p style="color: var(--gray); margin-top: 10px;">
          Altura da água: <strong id="waterHeight">0 cm</strong>
        </p>
      </div>
    </div>

    <!-- STATUS DO SISTEMA -->
    <div class="card">
      <div class="card-title">
        <i class="fas fa-heartbeat"></i>
        Status do Sistema
      </div>
      
      <div class="status-grid">
        <div class="status-item" id="sensorStatus">
          <div class="status-label">Sensor Ultrassônico</div>
          <div class="status-value">--</div>
        </div>
        
        <div class="status-item" id="loraStatus">
          <div class="status-label">Comunicação LoRa</div>
          <div class="status-value">--</div>
        </div>
        
        <div class="status-item" id="signalStatus">
          <div class="status-label">Qualidade do Sinal</div>
          <div class="status-value">--</div>
        </div>
        
        <div class="status-item" id="lastUpdateStatus">
          <div class="status-label">Última Atualização</div>
          <div class="status-value">--</div>
        </div>
      </div>
    </div>

    <!-- GRÁFICO -->
    <div class="card">
      <div class="card-title">
        <i class="fas fa-chart-line"></i>
        Histórico do Nível (últimas 24h)
      </div>
      <div class="chart-container">
        <canvas id="levelChart"></canvas>
      </div>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
